# Copy to .env and fill in real values. Startup fails fast (pydantic-settings
# ValidationError) when a required variable below is missing or invalid.

# --- Required ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 characters each (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
JWT_SECRET=
SESSION_SECRET=
# Must be a valid Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# --- OAuth ---
GEMINI_API_KEY=
REDIRECT_URI=http://localhost:8000/api/auth/google/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/api/auth/notion/callback

# --- URLs / cookies ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_expense_tracker
FRONTEND_URL=http://localhost:5173
# Optional override. Unset = derived from FRONTEND_URL (https:// frontend → secure
# cookies). Set "true"/"false" only to override that derivation.
COOKIE_SECURE=

# --- CORS ---
# Comma-separated exact origins. Localhost plus the deployed frontend only;
# add preview URLs here or use ALLOWED_ORIGIN_REGEX instead.
ALLOWED_ORIGINS=http://localhost:5173,https://ai-expense-tracker-frontend-bice.vercel.app
# Optional regex matched against the Origin header, passed to
# CORSMiddleware(allow_origin_regex=...) (or None when blank). Leave blank to disable.
# Project-scoped and anchored so it can't match somebody else's deployment:
# ^https://ai-expense-tracker-frontend-[a-z0-9]+-wunnas-projects\.vercel\.app$
ALLOWED_ORIGIN_REGEX=
